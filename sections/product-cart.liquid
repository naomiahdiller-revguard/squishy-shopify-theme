<section class="section"><div class="page-width"><div class="eyebrow">Your bag</div><h1 class="section-title">A tiny ocean is almost yours.</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-line">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.title }}{% endif %}<div><strong>{{ item.product.title }}</strong><p>{{ item.variant.title }}</p><label for="updates_{{ item.key }}">Quantity</label> <input class="cart-qty" id="updates_{{ item.key }}" name="updates[]" value="{{ item.quantity }}" min="0" type="number"></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}<div class="cart-total"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><small>Shipping and taxes calculated at checkout.</small><div><button class="btn btn-ghost" type="submit" name="update">Update bag</button> <button class="btn" type="submit" name="checkout">Checkout</button></div></div></form>{% else %}<div class="empty-state"><p>Your bag is waiting for something dreamy.</p><a class="btn" href="{{ routes.root_url }}#shop">Shop the Ocean Cube</a></div>{% endif %}</div></section>
{% schema %}{"name":"Cart","settings":[]}{% endschema %}
