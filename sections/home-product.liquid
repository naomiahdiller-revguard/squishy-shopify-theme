{% liquid
  assign featured_product = section.settings.product
  if featured_product == blank
    assign featured_product = collections.all.products.first
  endif
%}
<section class="home-buy section" id="shop"><div class="page-width home-buy-grid"><div class="home-buy-gallery reveal"><img src="{{ 'ocean squish main product image.avif' | asset_url }}" alt="Ocean Drift Squish Cube"><div><img src="{{ 'ocean squish squished.png' | asset_url }}" alt="Ocean Cube being squished"><img src="{{ 'ocean squish 3 in package.avif' | asset_url }}" alt="Ocean Cube packaging"></div></div><div class="home-buy-info reveal"><div class="eyebrow">The original tiny escape</div><h2 class="section-title">{{ featured_product.title | default: 'Ocean Drift Squish Cube' }}</h2><p class="home-price">{% if featured_product != blank %}{{ featured_product.price | money }}{% else %}$18.00{% endif %}</p><p class="hero-copy">A transparent, slow-rising squishy filled with a dreamy miniature ocean scene. Made for satisfying squeezes, desk-side calm and extremely cute shelf energy.</p><div class="home-points"><p><strong>Satisfyingly slow</strong><br><small>Squish it flat, then watch it gently find its shape again.</small></p><p><strong>A miniature ocean scene</strong><br><small>Clear aqua color, shimmer and tiny sea details from every angle.</small></p><p><strong>Made to keep close</strong><br><small>Perfect for a desk, nightstand or thoughtful little gift.</small></p></div>{% if featured_product != blank %}{% form 'product', featured_product, class: 'product-form' %}<input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}"><button class="btn btn-wide" type="submit" {% unless featured_product.available %}disabled{% endunless %}>{% if featured_product.available %}Add to bag — {{ featured_product.price | money }}{% else %}Sold out{% endif %}</button>{% endform %}<a class="product-link" href="{{ featured_product.url }}">See every detail →</a>{% else %}<a class="btn" href="{{ routes.all_products_collection_url }}">Shop the Ocean Cube</a><p class="setup-note">Select the Ocean Drift product in this section after the theme is connected.</p>{% endif %}</div></div></section>
{% schema %}{"name":"Homepage product","settings":[{"type":"product","id":"product","label":"Product"}],"presets":[{"name":"Homepage product"}]}{% endschema %}
