{% assign current_variant = product.selected_or_first_available_variant %}
<section class="ocean-hero"><div class="page-width hero-grid"><div class="reveal"><div class="eyebrow">Orbitra sensory • ocean collection</div><h1 class="hero-title">Ocean Drift<br>Squish Cube</h1><p class="hero-copy">A tiny ocean you can hold. Squeeze the crystal-clear aqua gel and watch shells, stars and shimmer drift through your hands—then let it slowly settle back into shape.</p><div class="price-row"><span class="price">{{ current_variant.price | money }}</span>{% if current_variant.compare_at_price > current_variant.price %}<span class="compare">{{ current_variant.compare_at_price | money }}</span><span class="badge">Save</span>{% endif %}</div>{% form 'product', product, id:'product-form' %}<input type="hidden" name="id" value="{{ current_variant.id }}"><button class="btn btn-wide" type="submit" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add a little ocean to my cart{% else %}Sold out{% endif %}</button>{% endform %}<div class="micro">Secure checkout • Designed for satisfying squeezes • Giftable packaging</div></div><div class="hero-media reveal"><img src="{{ 'ocean squish main product image.avif' | asset_url }}" alt="Ocean Drift Squish Cube" width="900" height="900"><div class="float-note one">✦ slow-squish sensory gel</div><div class="float-note two">☼ shells + shimmer inside</div></div></div></section>
<div class="trust-strip"><div class="page-width trust-grid"><div class="trust-item">✦ Mesmerizing movement</div><div class="trust-item">♡ Stress-relief friendly</div><div class="trust-item">☼ Pocket-size escape</div><div class="trust-item">⌁ Secure checkout</div></div></div>
<div class="sticky-buy"><div><strong>Ocean Drift Cube</strong><br><small>{{ current_variant.price | money }}</small></div><button class="btn" data-scroll-buy>Get yours</button></div>
{% schema %}{"name":"Ocean product","settings":[],"presets":[{"name":"Ocean product"}]}{% endschema %}