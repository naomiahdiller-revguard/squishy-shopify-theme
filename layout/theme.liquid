<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#073b4c"><link rel="canonical" href="{{ canonical_url }}">
<title>{% if page_title %}{{ page_title }} — {% endif %}{{ shop.name }}</title>
{{ content_for_header }}
{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ 'ocean.css' | asset_url | stylesheet_tag }}
<script src="{{ 'theme.js' | asset_url }}" defer></script>
</head>
<body class="template-{{ template.name | handle }}">
<a class="skip-link" href="#MainContent">Skip to content</a>
{% section 'global-announcement' %}
{% section 'global-header' %}
<main id="MainContent">{{ content_for_layout }}</main>
{% section 'global-footer' %}
</body>
</html>
